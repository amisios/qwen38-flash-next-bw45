# Default profile: one 32 GB Blackwell GPU (sm_120) + 128 GB system RAM, 256K context, RAM-resident.
#
# Every value is a default: a variable already set in the environment (for example from .env) wins.
# One request at a time, up to 262,144 tokens in total (prompt + generated).
# Nothing is read from disk while serving: every cold expert and the 51 GB PLE table are loaded into RAM at
# startup (QWEN38_REQUIRE_RAM_RESIDENT=1 refuses to start if the memory limit cannot hold them).
# See docs/tuning.md before changing the GPU memory settings: hot experts and the KV cache share the 32 GB.

: "${PORT:=8000}"
: "${SERVED_MODEL_NAME:=Qwen3.8-Flash-Next}"
: "${MAX_MODEL_LEN:=262144}"
: "${MAX_NUM_SEQS:=1}"
: "${MAX_NUM_BATCHED_TOKENS:=8192}"
: "${MAX_PARALLEL_LOADING_WORKERS:=1}"

# INT8 per-token-head KV cache. Capacity must be at least 1.05x MAX_MODEL_LEN (275,251 tokens for 262,144):
# async prefill holds extra recurrent-state blocks. 4.7 GB is extrapolated from two measured points (2.0 GB holds
# 49,152 tokens, 3.05 GB holds 141,504, ~11.4 KB per extra token) to ~287K tokens; check the startup log line
# "GPU KV cache size". The INT8 attention block is 3,200 tokens, so the prefix-cache retention interval must be a
# multiple of 3,200.
: "${KV_CACHE_DTYPE:=int8_per_token_head}"
: "${KV_CACHE_MEMORY_BYTES:=4700000000}"
: "${VLLM_PREFIX_CACHE_RETENTION_INTERVAL:=3200}"

# MTP speculative decoding: 3 draft tokens, so a decode step verifies 4 tokens (the CPU path handles up to 4).
: "${MTP_DEPTH:=3}"
: "${VLLM_MTP_DRAFT_VOCAB_RANGES:=[[0,65536],[248044,248320]]}"

# Experts: 64 hot experts per layer stay on the GPU (~116 MiB of VRAM per hot expert per layer); the other 448 per
# layer are computed by the CPU during decode and streamed to the GPU during prefill. Start value: raise it after
# measuring the peak VRAM of a full-length request (docs/tuning.md).
: "${QWEN38_HOT_ONLY:=64}"
# Cold experts kept in RAM: "auto" = (memory budget - RAM-resident PLE table - 10 GiB overhead), at most all of
# them. With QWEN38_REQUIRE_RAM_RESIDENT=1 the server stops at startup unless every cold expert fits.
: "${QWEN38_EXPERT_ARENA_SLOTS:=auto}"
: "${QWEN38_REQUIRE_RAM_RESIDENT:=1}"
# PLE table: 0 = loaded into RAM by the PLE worker at startup (47.8 GiB); 1 = rows read from the checkpoint through
# the page cache (disk reads on first touch).
: "${QWEN38_PLE_MMAP:=0}"
: "${QWEN38_PLE_THREADS:=4}"
# Prefill: cold experts are copied to the GPU in groups of 80; chunks of up to 384 tokens use the CPU instead.
: "${QWEN38_STREAM_GROUP:=80}"
: "${QWEN38_CPU_PREFILL_MAX:=384}"
# No disk tier, so no promotions from disk into RAM.
: "${QWEN38_EXPERT_PROMOTE:=0}"
# Decode: the GPU computes ~22% of each layer's cold experts itself, over PCIe, while the CPU does the rest. Tuned on
# PCIe 4.0; on a PCIe 5.0 slot a higher value may balance better (docs/tuning.md).
: "${QWEN38_GPU_SHARE_FRAC:=0.22}"
# CPU placement: "auto" derives the pool and serving-process CPUs from the topology (vllm/qwen38_host.py).
: "${QWEN38_CPU_EXPERTS_CPUS:=auto}"
: "${QWEN38_MAIN_CPUS:=auto}"
# Diagnostics: log CPU/GPU decode step times every N steps (0 = off).
: "${QWEN38_CPU_EXPERTS_STATS:=0}"
: "${QWEN38_STREAM_PROFILE:=0}"

: "${QWEN38_ASYNC_SCHEDULING:=1}"
# The Triton skinny-GEMM path of the base image only runs on sm_86 (RTX 3090); on Blackwell it is a no-op.
: "${QWEN38_TRITON_SKINNY:=0}"
: "${PYTORCH_CUDA_ALLOC_CONF:=expandable_segments:True}"
: "${VLLM_PLE_OFFLOAD_READY_TIMEOUT:=1200}"
: "${VLLM_QSA_EXACT_TOPK:=0}"

export PORT SERVED_MODEL_NAME MAX_MODEL_LEN MAX_NUM_SEQS MAX_NUM_BATCHED_TOKENS MAX_PARALLEL_LOADING_WORKERS
export KV_CACHE_DTYPE KV_CACHE_MEMORY_BYTES VLLM_PREFIX_CACHE_RETENTION_INTERVAL MTP_DEPTH VLLM_MTP_DRAFT_VOCAB_RANGES
export QWEN38_HOT_ONLY QWEN38_EXPERT_ARENA_SLOTS QWEN38_REQUIRE_RAM_RESIDENT QWEN38_PLE_MMAP QWEN38_PLE_THREADS
export QWEN38_STREAM_GROUP QWEN38_CPU_PREFILL_MAX QWEN38_EXPERT_PROMOTE QWEN38_GPU_SHARE_FRAC
export QWEN38_CPU_EXPERTS_CPUS QWEN38_MAIN_CPUS QWEN38_CPU_EXPERTS_STATS QWEN38_STREAM_PROFILE
export QWEN38_ASYNC_SCHEDULING QWEN38_TRITON_SKINNY PYTORCH_CUDA_ALLOC_CONF VLLM_PLE_OFFLOAD_READY_TIMEOUT
export VLLM_QSA_EXACT_TOPK
