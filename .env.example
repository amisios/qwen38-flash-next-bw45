# Copy to .env and adjust (.env is git-ignored). Compose reads this file for compose.yaml and passes it into the
# container, where it overrides the profile defaults in configs/bw45-128gb-256k.env.

# Absolute host path of the downloaded checkpoint (hf download ... --local-dir).
MODEL_DIR=/models/qwen38-flash-next

# API port and bind address. 0.0.0.0 = reachable from the network (Docker-published ports bypass host firewall
# rules); 127.0.0.1 = this machine only.
PORT=8000
BIND_ADDRESS=0.0.0.0
# Require this bearer token on the OpenAI-compatible API (unset = no authentication).
# VLLM_API_KEY=

# Which GPU to use (nvidia-smi index).
GPU_DEVICE=0

# Memory for the whole serving container: expert arena + PLE table + processes. The default profile needs
# ~109 GiB (64 hot experts per layer, PLE table in RAM); 118g suits a 128 GB machine (MemTotal ~125.6 GiB).
# make preflight checks this value against the host.
COMPOSE_MEMORY_LIMIT=118g

# Prebuilt image instead of the local build (pin a digest):
# IMAGE=ghcr.io/<owner>/qwen38-flash-next-bw45@sha256:<digest>

# Profile overrides (defaults in configs/bw45-128gb-256k.env; see docs/tuning.md). Keep comments on their own
# lines: compose does not strip trailing comments from values in env files.
# Hot experts per layer kept on the GPU (~116 MiB of VRAM per expert per layer):
# QWEN38_HOT_ONLY=64
# INT8 KV cache bytes; capacity must stay >= 1.05x MAX_MODEL_LEN:
# KV_CACHE_MEMORY_BYTES=4700000000
# MAX_MODEL_LEN=262144
# Share of each decode layer's cold experts computed by the GPU over PCIe:
# QWEN38_GPU_SHARE_FRAC=0.22
# Pin the CPU expert pool yourself, e.g. 2-7,10-15:
# QWEN38_CPU_EXPERTS_CPUS=auto
# Log decode step timings every 64 steps:
# QWEN38_CPU_EXPERTS_STATS=64
# 0 = PLE table in RAM (no disk reads while serving), 1 = rows read from the checkpoint via the page cache:
# QWEN38_PLE_MMAP=0
# 1 = refuse to start if any cold expert would have to be read from disk while serving:
# QWEN38_REQUIRE_RAM_RESIDENT=1
